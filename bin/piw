#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${PI_GRAPH_CORE_PYTHON:-}" ]; then
  python_bin=$PI_GRAPH_CORE_PYTHON
elif [ -x "$root/.venv/bin/python" ]; then
  python_bin="$root/.venv/bin/python"
elif [ -x "$(dirname -- "$0")/python" ]; then
  python_bin="$(dirname -- "$0")/python"
else
  python_bin=python3
fi
exec "$python_bin" "$root/scripts/piw.py" "$@"
