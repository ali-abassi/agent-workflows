#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${AGENT_WORKFLOWS_PYTHON:-}" ]; then
  python_bin=$AGENT_WORKFLOWS_PYTHON
elif [ -x "$root/.venv/bin/python" ]; then
  python_bin="$root/.venv/bin/python"
elif [ -x "$(dirname -- "$0")/python" ]; then
  python_bin="$(dirname -- "$0")/python"
else
  python_bin=python3
fi
if ! "$python_bin" -c "import agent_workflows" >/dev/null 2>&1; then
  printf '%s\n' "Agent Workflows is not installed in $python_bin." >&2
  printf '%s\n' "Run: $root/.venv/bin/python -m pip install -e $root" >&2
  exit 2
fi
exec "$python_bin" -m agent_workflows.cli "$@"
